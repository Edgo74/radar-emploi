# Copie ce fichier en .env.local et remplis les valeurs TOI-MÊME.
# Ne colle jamais ces valeurs dans un chat. .env.local n'est jamais commité.
# Sur Vercel : Project → Settings → Environment Variables, mêmes noms.

# Mot de passe pour ouvrir le site (choisis-le)
SITE_PASSWORD=

# Supabase → Project Settings → API (projet en région EU)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# francetravail.io → Mon espace → ton application → identifiant / clé secrète
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# developer.adzuna.com → Dashboard → API Access Details
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# apify.com → Settings → API & Integrations
APIFY_TOKEN=

# Secret du cron : une longue chaîne aléatoire (Vercel l'envoie au cron automatiquement)
CRON_SECRET=

# Ton profil pour la notation IA (texte libre, entre accents graves `...` s'il tient sur plusieurs lignes)
PROFIL_CANDIDAT=
